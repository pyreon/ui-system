{
  "extends": "@vitus-labs/tools-typescript/lib",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "customConditions": ["bun"]
  },
  "exclude": ["node_modules", "**/dist/**", "**/lib/**"]
}
