{
  "$schema": "https://biomejs.dev/schemas/2.4.7/schema.json",
  "extends": ["@vitus-labs/tools-lint/biome"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist/**", "!**/lib/**", "!**/node_modules/**"]
  },
  "formatter": {
    "lineWidth": 100
  },
  "javascript": {
    "globals": [
      "describe",
      "it",
      "test",
      "expect",
      "vi",
      "beforeEach",
      "afterEach",
      "beforeAll",
      "afterAll"
    ],
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "rules": {
      "correctness": {
        "useHookAtTopLevel": "off"
      }
    }
  }
}
