{
  "name": "@pyreon/ui-core",
  "version": "0.0.1",
  "description": "Core utilities, config, and context for Pyreon UI System",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "source": "./src/index.ts",
    "import": "./lib/index.js",
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "main": "./lib/index.js",
  "files": ["lib", "!lib/**/*.map"],
  "engines": { "node": ">= 18" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "bun run vl_rolldown_build",
    "lint": "biome check src/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@pyreon/core": ">=0.0.1",
    "@pyreon/styler": ">=0.0.1"
  },
  "devDependencies": {
    "@vitus-labs/tools-rolldown": "1.9.1-alpha.19",
    "@vitus-labs/tools-typescript": "1.9.1-alpha.19"
  }
}
