{
  "name": "@pyreon/ui-core",
  "version": "0.3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pyreon/ui-system",
    "directory": "packages/ui-core"
  },
  "description": "Core utilities, config, and context for Pyreon UI System",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "source": "./src/index.ts",
    "import": "./lib/index.js",
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "!lib/**/*.map",
    "!lib/analysis",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">= 18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run vl_rolldown_build",
    "lint": "biome check src/",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@pyreon/core": ">=0.4.0 <1.0.0",
    "@pyreon/styler": ">=0.3.0"
  },
  "devDependencies": {
    "@vitus-labs/tools-rolldown": "^1.15.3",
    "@pyreon/typescript": "^0.7.4"
  }
}
