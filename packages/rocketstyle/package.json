{
  "name": "@pyreon/rocketstyle",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "source": "./src/index.ts",
    "import": "./lib/index.js",
    "types": "./lib/index.d.ts"
  },
  "types": "./lib/index.d.ts",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "!lib/**/*.map"
  ],
  "engines": {
    "node": ">= 18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublish": "bun run build",
    "build": "bun run vl_rolldown_build",
    "build:watch": "bun run vl_rolldown_build-watch",
    "lint": "biome check src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@pyreon/core": ">=0.3.0",
    "@pyreon/reactivity": ">=0.3.0",
    "@pyreon/ui-core": "workspace:^",
    "@pyreon/styler": "workspace:^"
  },
  "devDependencies": {
    "@vitus-labs/tools-rolldown": "^1.15.0",
    "@vitus-labs/tools-typescript": "^1.15.0"
  }
}
