{
  "name": "pyreon-ui-system",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --filter='*' build",
    "test": "bun run --filter='*' test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "bun run --filter='*' typecheck"
  },
  "overrides": {
    "@pyreon/core": "file:../pyreon/packages/core",
    "@pyreon/reactivity": "file:../pyreon/packages/reactivity"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@pyreon/core": "file:../pyreon/packages/core",
    "@pyreon/reactivity": "file:../pyreon/packages/reactivity",
    "@types/bun": "^1.3.10",
    "typescript": "^5.7.3"
  }
}
