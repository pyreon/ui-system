{
  "name": "@pyreon/ui-system-root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": ["packages/*", "examples/*"],
  "scripts": {
    "release": "lerna publish --force-publish",
    "lint": "biome check packages/*/src/",
    "format": "biome format --write packages/*/src/",
    "pkgs:build": "lerna run build --stream",
    "pkgs:clean": "rm -rf node_modules packages/*/node_modules && bun install",
    "build": "bun run --filter='*' build",
    "test": "vitest run",
    "typecheck": "lerna run typecheck --stream",
    "atlas": "vl_atlas"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@pyreon/compiler": "^0.3.0",
    "@pyreon/core": "^0.3.0",
    "@pyreon/reactivity": "^0.3.0",
    "@pyreon/runtime-dom": "^0.3.0",
    "@pyreon/vite-plugin": "^0.3.0",
    "@types/bun": "^1.3.10",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitus-labs/tools-atlas": "1.9.1-alpha.1",
    "@vitus-labs/tools-lint": "1.9.1-alpha.19",
    "@vitus-labs/tools-rolldown": "1.15.0",
    "@vitus-labs/tools-typescript": "1.9.1-alpha.19",
    "@vitus-labs/tools-vitest": "1.9.1-alpha.1",
    "jsdom": "^28.1.0",
    "lerna": "^9.0.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
